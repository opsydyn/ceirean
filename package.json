{
  "name": "leviathan",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "probes/*"
  ],
  "type": "module",
  "scripts": {
    "lint": "NODE_OPTIONS=--experimental-strip-types oxlint --config oxlint.config.ts --deny-warnings .",
    "lint:fix": "NODE_OPTIONS=--experimental-strip-types oxlint --config oxlint.config.ts --deny-warnings --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check"
  },
  "devDependencies": {
    "@opsydyn/oxlint-effect": "2.0.1",
    "bun-types": "1.4.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "@flue/runtime@2.3.0": "patches/@flue%2Fruntime@2.3.0.patch",
    "gaxios@7.3.1": "patches/gaxios@7.3.1.patch"
  }
}
